{
  "name": "zoutex",
  "version": "0.1.0",
  "description": "Type-safe routes for Next.js App Router, powered by Zod. Define once, get types, runtime validation, and OpenAPI.",
  "keywords": [
    "nextjs",
    "app-router",
    "zod",
    "openapi",
    "type-safe",
    "api",
    "routes"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "zoutex": "dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./next": {
      "types": "./dist/next.d.mts",
      "import": "./dist/next.mjs"
    },
    "./openapi": {
      "types": "./dist/openapi.d.mts",
      "import": "./dist/openapi.mjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check": "biome check",
    "fix": "biome check --write",
    "format": "biome format --write",
    "lint": "biome lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "playground": "npm run build && npm -w apps/zoutex-playground run dev",
    "test:e2e": "npm run build && npm -w apps/zoutex-playground run test",
    "release": "semantic-release"
  },
  "release": {
    "branches": ["main"],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  },
  "peerDependencies": {
    "next": ">=14",
    "typescript": ">=5.0.0",
    "zod": ">=4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^25.8.0",
    "@vitest/coverage-v8": "^4.0.0",
    "next": "^14.0.0",
    "semantic-release": "^25.0.3",
    "tsdown": "^0.22.0",
    "tsx": "^4.22.0",
    "typescript": "^5.4.0",
    "vitest": "^4.0.0",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "picocolors": "^1.1.1",
    "zod-openapi": "^5.4.6"
  }
}
